# Public Wix headless client (not a secret). Created for the "Clutch Auto Deals website" OAuth app.
WIX_CLIENT_ID=70dd81ca-f940-4ee0-bb72-8b14cf26d267
# Wix Forms form that every site lead form submits into ("Website Quote Request").
WIX_LEAD_FORM_ID=ec479b25-9b2f-4481-bd4f-d157c43c8e75
# Optional: licensed IMAGIN.studio customer key. When set, models with no image in the
# Vehicle image library get an IMAGIN studio render instead of the placeholder.
IMAGIN_CUSTOMER_KEY=
# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://www.clutchautodeals.com
